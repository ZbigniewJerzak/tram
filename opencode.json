{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "provider": {
    "bht_llms": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://inference.cluster.ris.bht-berlin.de/v1",
        "headers": {
          "x-api-key": "8hbQCz6PFoXMDpQvVqsU"
        }
      },
      "models": {
        "bht/large": {
          "name": "BHT Large LLM",
          "limit": {
            "context": 196000,
            "output": 4096
          }
        },
        "bht/medium": {
          "name": "BHT Medium LLM",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "bht/small": {
          "name": "BHT Small LLM",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
}